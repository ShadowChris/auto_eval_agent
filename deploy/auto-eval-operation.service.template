# 模板：先复制为 auto-eval-operation.service，再修改用户和路径后安装。
# 下列用户和路径均为示例，按同目录 README.md 手动替换。
[Unit]
Description=Auto Eval Operation Web Service

[Service]
# 使用日常运行项目的普通用户；需能读取数据、.env 并写入 runs/。
User=ubuntu
# 项目根目录，等同于启动前 cd 到这里。
WorkingDirectory=/home/ubuntu/auto_eval_agent
# 仅在此环境中查找外部命令；缺少命令时直接报错，不回退到系统 PATH。
Environment="PATH=/home/ubuntu/miniconda3/envs/auto_eval/bin"
# 使用环境中 Python 的绝对路径，无需 conda activate；-u 让日志及时输出。
# 启动方式与原来一致；地址和端口使用 server.py 中的设置。
ExecStart=/home/ubuntu/miniconda3/envs/auto_eval/bin/python -u -m src.auto_eval.web.server
# 进程退出后等待 5 秒重新启动；手动 systemctl stop 不会触发重启。
Restart=always
RestartSec=5

[Install]
# 配合 systemctl enable，实现开机自启。
WantedBy=multi-user.target
